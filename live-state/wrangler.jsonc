{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pip-live-state",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["global_fetch_strictly_public", "enable_request_signal"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://pip-tutor-tizav.pages.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STATE",
        "class_name": "LiveState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LiveState"]
    }
  ],
  "observability": {
    "enabled": false
  }
  // Secrets, set with `wrangler secret put`, never in source or NEXT_PUBLIC_*:
  // OWNER_KEY (signs browsers in) and ANTHROPIC_API_KEY (pays for answers).
}
